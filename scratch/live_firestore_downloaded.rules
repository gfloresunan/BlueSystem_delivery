rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// BLUESYSTEM DELIVERY ENTERPRISE — Firestore Security Rules (EIAM v2.1)
// Enterprise Identity & Access Management
//
// Estrategia de seguridad EIAM v2.1:
//   1. Custom Claims (role, businessId, branchId, orgId) del token JWT
//   2. Validación estricta: resource.data.businessId == request.auth.token.businessId
//   3. Soporte para estructura de Holding: /organizations/{orgId}
//   4. Ningún usuario puede leer o escribir datos de otro tenant
//   5. Plataforma ADMIN tiene acceso de lectura/auditoría global
//
// DESPLIEGUE: firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAppCheckVerified() {
      // App Check token validation (Play Integrity / reCAPTCHA Enterprise)
      return request.auth != null && (request.auth.token.firebase.get("app_check", false) == true || request.auth.token.get("app_check", false) == true);
    }

    function currentUid() {
      return request.auth.uid;
    }

    function getRole() {
      return request.auth.token.get("role", request.auth.token.get("eiamRole", "GUEST"));
    }

    function getBusinessId() {
      return request.auth.token.get("businessId", null);
    }

    function getBranchId() {
      return request.auth.token.get("branchId", null);
    }

    function getOrgId() {
      return request.auth.token.get("orgId", null);
    }

    // ─── EIAM v3 Helpers (Fase 2C.6) ──────────────────────────────────────────
    function getTenantId() {
      return request.auth.token.get("tenantId", null);
    }

    function getBrandId() {
      return request.auth.token.get("brandId", null);
    }

    function isEiamV3() {
      return request.auth.token.get("eiamVer", 0) == 3;
    }

    function isTenantMember(resourceTenantId) {
      return isPlatformAdmin() || (getTenantId() != null && resourceTenantId != null && getTenantId() == resourceTenantId);
    }

    function canAccessTenant(resourceTenantId) {
      return isPlatformAdmin() || (getTenantId() != null && resourceTenantId != null && getTenantId() == resourceTenantId);
    }

    function canAccessBrand(resourceTenantId, resourceBrandId) {
      return isPlatformAdmin() || (
        isTenantMember(resourceTenantId) && (
          getBrandId() == null || resourceBrandId == null || getBrandId() == resourceBrandId
        )
      );
    }

    // Roles de plataforma con acceso global
    function isPlatformAdmin() {
      return isAuthenticated() && (
        getRole() in ["SUPER_ADMIN", "ADMIN", "AUDITOR", "SUPPORT", "SUPERVISOR", "OPERATOR", "OPERATIONS", "super_admin", "admin", "auditor", "support", "supervisor", "operator", "operations"] ||
        request.auth.token.get("eiamRole", "") in ["SUPER_ADMIN", "ADMIN", "AUDITOR", "SUPPORT", "SUPERVISOR", "OPERATOR", "OPERATIONS", "super_admin", "admin", "auditor", "support", "supervisor", "operator", "operations"] ||
        request.auth.token.get("role", "") in ["SUPER_ADMIN", "ADMIN", "AUDITOR", "SUPPORT", "SUPERVISOR", "OPERATOR", "OPERATIONS", "super_admin", "admin", "auditor", "support", "supervisor", "operator", "operations"] ||
        request.auth.token.get("admin", false) == true ||
        request.auth.token.get("isSuperAdmin", false) == true ||
        request.auth.token.get("supervisor", false) == true ||
        request.auth.token.get("isPlatformAdmin", false) == true
      );
    }

    function isSuperAdmin() {
      return getRole() in ["SUPER_ADMIN", "super_admin"];
    }

    function isSupervisor() {
      return isAuthenticated() && (
        getRole() in ["SUPERVISOR", "supervisor", "MERCHANT_SUPERVISOR"] ||
        request.auth.token.get("eiamRole", "") in ["SUPERVISOR", "supervisor", "MERCHANT_SUPERVISOR"] ||
        request.auth.token.get("role", "") in ["SUPERVISOR", "supervisor", "MERCHANT_SUPERVISOR"] ||
        request.auth.token.get("supervisor", false) == true
      );
    }

    // Roles con capacidad de gestionar empleados/sucursales / administradores de tenant
    function isBusinessAdmin() {
      return getRole() in ["OWNER", "MANAGER", "MERCHANT_OWNER", "MERCHANT_MANAGER", "TENANT_ADMIN", "owner", "manager", "merchant_owner", "merchant_manager", "tenant_admin"] ||
             request.auth.token.get("eiamRole", "") in ["OWNER", "MANAGER", "MERCHANT_OWNER", "MERCHANT_MANAGER", "TENANT_ADMIN", "owner", "manager", "merchant_owner", "merchant_manager", "tenant_admin"] ||
             request.auth.token.get("role", "") in ["OWNER", "MANAGER", "MERCHANT_OWNER", "MERCHANT_MANAGER", "TENANT_ADMIN", "owner", "manager", "merchant_owner", "merchant_manager", "tenant_admin"];
    }

    // Cualquier staff del comercio
    function isBusinessStaff() {
      return getRole() in ["OWNER", "MANAGER", "SUPERVISOR", "CASHIER", "COOK", "MERCHANT_OWNER", "MERCHANT_MANAGER", "MERCHANT_SUPERVISOR", "MERCHANT_CASHIER", "MERCHANT_COOK"];
    }

    // Repartidor/Motorizado con identidad verificada (Token Claim o Documento /users/{uid} o /couriers/{uid} activo)
    function isCourierOrDriver() {
      return isAuthenticated() && (
        getRole() in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
        request.auth.token.get("userType", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
        request.auth.token.get("eiamRole", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
        request.auth.token.get("role", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("userType", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("eiamRole", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("rol", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO", "driver", "DRIVER", "repartidor", "REPARTIDOR"])) ||
        (exists(/databases/$(database)/documents/couriers/$(request.auth.uid)))
      );
    }

    // Valida que el businessId del claim coincide exactamente con el recurso (o sus campos legacy determinísticos)
    function getOrderBusinessId(resData) {
      return resData.get("businessId", resData.get("comercioId", resData.get("restaurantId", resData.get("merchantId", null))));
    }

    function ownsBusiness(resourceBusinessId) {
      return isPlatformAdmin() || (getBusinessId() != null && resourceBusinessId != null && getBusinessId() == resourceBusinessId);
    }

    function isWritingOwnBusinessId() {
      return isPlatformAdmin() || (request.resource.data.businessId == getBusinessId() || request.resource.data.get("comercioId", "") == getBusinessId());
    }

    // ─── /tenants/{tenantId} (EIAM v3 & Multi-Tenant) ────────────────────────
    match /tenants/{tenantId} {
      allow read: if (resource.data.status == "ACTIVE") ||
                     (isAuthenticated() && (isPlatformAdmin() || getTenantId() == tenantId || isTenantMember(tenantId)));
      allow create, update, delete: if isSuperAdmin() || isPlatformAdmin();

      // Tenant Override for Customer Dashboard Configuration (Addendum P0-01)
      match /dashboard/{docId} {
        allow read: if true;
        allow write: if isPlatformAdmin() || (isBusinessAdmin() && isTenantMember(tenantId));
      }
    }

    // ─── /tenantDomains/{domainId} (Fase 2E Multi-Domain) ─────────────────────
    match /tenantDomains/{domainId} {
      allow read: if (resource.data.status == "ACTIVE") ||
                     (isAuthenticated() && (isPlatformAdmin() || isTenantMember(resource.data.get("tenantId", null))));
      allow create, update: if isAuthenticated() &&
                               (isPlatformAdmin() || (isBusinessAdmin() && isTenantMember(request.resource.data.get("tenantId", null))));
      allow delete: if isAuthenticated() &&
                       (isPlatformAdmin() || (isBusinessAdmin() && isTenantMember(resource.data.get("tenantId", null))));
    }

    // ─── /brands/{brandId} (EIAM v3) ──────────────────────────────────────────
    match /brands/{brandId} {
      allow read: if true; // Public for marketplace & white-label branding
      allow create, update: if isAuthenticated() &&
                               (isPlatformAdmin() || (isBusinessAdmin() && isTenantMember(request.resource.data.get("tenantId", null))));
      allow delete: if isSuperAdmin();
    }

    // ─── /subscriptions/{subscriptionId} (Subscription Engine - Actividad #21) ─
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (isPlatformAdmin() || isTenantMember(resource.data.get("tenantId", null)));
      allow create, update, delete: if isSuperAdmin() || isPlatformAdmin();
    }

    // ─── /app_configs/{configId} (Commercial Product App Config - C2D.23) ───
    match /app_configs/{configId} {
      allow read: if isAuthenticated() && (isPlatformAdmin() || isTenantMember(resource.data.get("tenantId", null)));
      allow create, update, delete: if isSuperAdmin() || isPlatformAdmin();
    }

    // ─── /build_requests/{requestId} (Build Engine Foundation - C2D.25) ─────
    match /build_requests/{requestId} {
      allow read: if isAuthenticated() && (isPlatformAdmin() || isTenantMember(resource.data.get("tenantId", null)));
      allow create, update, delete: if isSuperAdmin() || isPlatformAdmin();
    }


    // ─── /organizations/{orgId} (EIAM v2.1 & v3) ─────────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuthenticated() &&
                     (isPlatformAdmin() || getOrgId() == orgId || resource.data.ownerUid == currentUid() ||
                      isTenantMember(resource.data.get("tenantId", null)));

      allow create, update: if isAuthenticated() &&
                               (isPlatformAdmin() || resource.data.ownerUid == currentUid() ||
                                isTenantMember(request.resource.data.get("tenantId", null)));

      allow delete: if isSuperAdmin();
    }

    // ─── /users/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated() &&
                     (currentUid() == uid || isPlatformAdmin() || isBusinessStaff() || isBusinessAdmin() ||
                      resource.data.get("role", "") in ["courier", "COURIER", "motorizado", "MOTORIZADO"] ||
                      resource.data.get("userType", "") in ["motorizado", "driver", "courier"]);

      allow update: if isAuthenticated() && (
                       // Administradores de plataforma autorizados pueden modificar identidades y roles
                       isPlatformAdmin() ||
                       // Usuario común solo puede actualizar sus datos de perfil no sensibles
                       (currentUid() == uid &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["role", "userType", "rol", "eiamRole", "isActive", "operationalMunicipalityId", "municipalityId", "cityId", "city", "departmentId", "department", "tenantId", "commercialTenantId"]))
                     );

      allow create: if isAuthenticated() && currentUid() == uid;
      allow delete: if isSuperAdmin();

      match /role_history/{historyId} {
        allow read: if isAuthenticated() &&
                       (currentUid() == uid || isPlatformAdmin());
        allow write: if isPlatformAdmin();
      }

      match /preferences/{doc} {
        allow read, write: if isAuthenticated() && currentUid() == uid;
      }

      match /settings/{doc} {
        allow read, write: if isAuthenticated() && currentUid() == uid;
      }

      match /notificationSettings/{doc} {
        allow read, write: if isAuthenticated() && currentUid() == uid;
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (currentUid() == uid || isPlatformAdmin());
        allow update: if isAuthenticated() && currentUid() == uid;
        allow write: if isPlatformAdmin();
      }

      match /shoppingCart/{doc} {
        allow read, write: if isAuthenticated() && currentUid() == uid;
      }

      match /favorites/{doc} {
        allow read, write: if isAuthenticated() && currentUid() == uid;
      }

      match /addresses/{addressId} {
        allow read: if isAuthenticated() && currentUid() == uid;
        allow create: if isAuthenticated() && currentUid() == uid &&
                      request.resource.data.userId == uid &&
                      request.resource.data.id == addressId;
        allow update: if isAuthenticated() && currentUid() == uid &&
                      resource.data.userId == uid &&
                      request.resource.data.userId == uid &&
                      request.resource.data.id == addressId;
        allow delete: if isAuthenticated() && currentUid() == uid &&
                      resource.data.userId == uid;
      }

      match /devices/{deviceId} {
        allow read, write: if isAuthenticated() && currentUid() == uid;
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isAuthenticated() && (currentUid() == uid || isPlatformAdmin());
      }

      match /loyalty/{businessId} {
        allow read: if isAuthenticated() && (currentUid() == uid || isPlatformAdmin());
        allow write: if isPlatformAdmin();
      }

      match /loyaltySummary/{doc} {
        allow read: if isAuthenticated() && (currentUid() == uid || isPlatformAdmin());
        allow write: if isPlatformAdmin();
      }

      match /loyaltyTransactions/{txId} {
        allow read: if isAuthenticated() && (currentUid() == uid || isPlatformAdmin());
        allow write: if isPlatformAdmin();
      }
    }

    match /businesses/{businessId} {
      // Lectura pública por diseño para catálogo y marketplace e-Commerce
      allow read: if true;

      // Creación: Platform Admin, o Business Admin para su propio negocio (con isFeatured = false)
      allow create: if isAuthenticated() && (
        isPlatformAdmin() ||
        (isBusinessAdmin() && isWritingOwnBusinessId() &&
         request.resource.data.get("isFeatured", false) == false &&
         request.resource.data.get("featured", false) == false &&
         request.resource.data.get("destacado", false) == false)
      );

      // Modificación: Platform Admin total; Business Admin sin permiso para alterar isFeatured ni metadatos de tenant/org
      allow update: if isAuthenticated() && (
        isPlatformAdmin() ||
        (isBusinessAdmin() && isWritingOwnBusinessId() &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(["isFeatured", "featured", "destacado", "tenantId", "orgId", "brandId"]))
      );

      allow delete: if isSuperAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin() || ownsBusiness(businessId));
      }

      match /subcategories/{subCatId} {
        allow read: if true;
        allow write: if isAuthenticated() && (isPlatformAdmin() || (isBusinessAdmin() && ownsBusiness(businessId)));
      }

      match /reviews/{reviewId} {
        allow read, write: if true;
      }
    }

    match /reviews/{reviewId} {
      // Lectura publica — necesaria para mostrar ratings en el marketplace
      allow read: if true;

      // FASE 1 — RC-002 SECURITY FIX
      // Solo un cliente autenticado puede crear una resena propia.
      // La resena debe pertenecer al usuario que la crea (customerId == uid)
      // y debe estar asociada a un pedido real (orderId no vacio).
      // Esto preserva el flujo real de OrdersViewModel.submitReview()
      // que ya incluye customerId = auth.currentUser?.uid
      allow create: if isAuthenticated() &&
                       request.resource.data.customerId == currentUid() &&
                       request.resource.data.get("orderId", "") != "";

      // Solo el creador original o un admin puede actualizar
      allow update: if isAuthenticated() &&
                       (resource.data.customerId == currentUid() || isPlatformAdmin());

      // Solo admin de plataforma puede eliminar
      allow delete: if isAuthenticated() && isPlatformAdmin();
    }

    match /coupons/{couponId} {
      // Lectura publica — cupones activos son visibles en el marketplace
      allow read: if true;

      // Creación:
      // - GLOBAL: Exclusivo de Platform Admin
      // - MERCHANT_SPECIFIC: Platform Admin o Business Admin para su propio negocio
      allow create: if isAuthenticated() && (
        (request.resource.data.get("scope", "GLOBAL") == "GLOBAL" && isPlatformAdmin()) ||
        (request.resource.data.get("scope", "") == "MERCHANT_SPECIFIC" &&
         (isPlatformAdmin() || (isBusinessAdmin() && isWritingOwnBusinessId() && request.resource.data.get("businessId", "") == getBusinessId())))
      );

      // Modificación / Eliminación:
      // - GLOBAL: Exclusivo de Platform Admin
      // - MERCHANT_SPECIFIC: Platform Admin o Business Admin propietario del negocio
      allow update: if isAuthenticated() && (
        (resource.data.get("scope", "GLOBAL") == "GLOBAL" && isPlatformAdmin()) ||
        (resource.data.get("scope", "") == "MERCHANT_SPECIFIC" &&
         (isPlatformAdmin() || (isBusinessAdmin() && ownsBusiness(resource.data.get("businessId", null)))))
      );

      allow delete: if isAuthenticated() && (
        (resource.data.get("scope", "GLOBAL") == "GLOBAL" && isPlatformAdmin()) ||
        (resource.data.get("scope", "") == "MERCHANT_SPECIFIC" &&
         (isPlatformAdmin() || (isBusinessAdmin() && ownsBusiness(resource.data.get("businessId", null)))))
      );
    }

    // ─── /coupon_redemptions/{redemptionId} ───────────────────────────────────
    match /coupon_redemptions/{redemptionId} {
      // Lectura: Cliente dueño de la redención, comercio del pedido, o Platform Admin
      allow read: if isAuthenticated() && (
        currentUid() == resource.data.customerId ||
        ownsBusiness(resource.data.get("businessId", null)) ||
        isPlatformAdmin()
      );

      // Inmutable para auditoría financiera — Exclusivo Admin SDK (Cloud Functions) y Platform Admin
      // Previene falsificación de redenciones desde clientes modificados.
      allow write, create, update, delete: if isPlatformAdmin();
    }

    // ─── /loyalty_rewards/{rewardId} ──────────────────────────────────────────
    match /loyalty_rewards/{rewardId} {
      // Lectura pública/autenticada para visualizar recompensas disponibles en el marketplace
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    // ─── /loyalty_levels/{levelId} ────────────────────────────────────────────
    match /loyalty_levels/{levelId} {
      // Lectura pública/autenticada de niveles y beneficios del programa de fidelidad
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    // ─── /loyalty_redemptions/{redemptionId} ──────────────────────────────────
    match /loyalty_redemptions/{redemptionId} {
      // Lectura: Cliente dueño de la redención o Platform Admin
      allow read: if isAuthenticated() && (
        currentUid() == resource.data.customerId ||
        ownsBusiness(resource.data.get("businessId", null)) ||
        isPlatformAdmin()
      );
      allow write, create, update, delete: if isPlatformAdmin();
    }

    // ─── /loyalty_settings/{doc} ──────────────────────────────────────────────
    match /loyalty_settings/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isPlatformAdmin();
    }

    // ─── /loyalty_awards/{awardId} ────────────────────────────────────────────
    match /loyalty_awards/{awardId} {
      // Exclusivo Admin SDK / Cloud Functions para garantizar idempotencia estricta
      allow read, write: if isPlatformAdmin();
    }

    match /branches/{branchId} {
      // Lectura pública por diseño para sedes y sucursales del catálogo del marketplace
      allow read: if true;

      allow write: if isAuthenticated() &&
                      isWritingOwnBusinessId() &&
                      (isPlatformAdmin() || isBusinessAdmin());

      allow delete: if isAuthenticated() &&
                       (isSuperAdmin() || getRole() == "OWNER");
    }

    // ─── /membership/{membershipId} (Legacy EIAM v2.1) ──────────────────────
    match /membership/{membershipId} {
      allow read: if isAuthenticated() &&
                     (currentUid() == resource.data.uid ||
                      ownsBusiness(resource.data.businessId) ||
                      isPlatformAdmin());

      allow create, update: if isAuthenticated() &&
                                isWritingOwnBusinessId() &&
                                (isPlatformAdmin() || isBusinessAdmin());

      allow delete: if isAuthenticated() &&
                       (isSuperAdmin() || getRole() == "OWNER");
    }

    // ─── /memberships/{membershipId} (Canónico EIAM v3) ──────────────────────
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() &&
                     (currentUid() == resource.data.uid ||
                      isTenantMember(resource.data.tenantId) ||
                      isPlatformAdmin());

      allow create: if isAuthenticated() &&
                       (isPlatformAdmin() || (isBusinessAdmin() && isTenantMember(request.resource.data.tenantId))) &&
                       request.resource.data.schemaVersion == "3.0";

      allow update: if isAuthenticated() &&
                       (isPlatformAdmin() || (isBusinessAdmin() && isTenantMember(resource.data.tenantId))) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(["membershipId", "uid", "tenantId", "createdAt", "schemaVersion"]);

      allow delete: if isAuthenticated() &&
                       (isSuperAdmin() || (isBusinessAdmin() && isTenantMember(resource.data.tenantId)));
    }

    // ─── /employees/{employeeId} ─────────────────────────────────────────────
    match /employees/{employeeId} {
      allow read: if isAuthenticated() &&
                     (currentUid() == resource.data.uid ||
                      ownsBusiness(resource.data.businessId) ||
                      isPlatformAdmin());

      allow create, update: if isAuthenticated() &&
                               isWritingOwnBusinessId() &&
                               (isPlatformAdmin() || isBusinessAdmin());

      allow delete: if isAuthenticated() &&
                       (isSuperAdmin() || getRole() in ["OWNER", "ADMIN"]);
    }

    // ─── /invitations/{token} ────────────────────────────────────────────────
    match /invitations/{token} {
      // Permitir lectura individual (get) por token ID para el flujo público de validación de invitación (accept-invite)
      allow get: if true;

      // Restringir el escaneo coleccional (list) exclusivamente a Platform Admin y Business Admin de su propio tenant
      allow list: if isAuthenticated() &&
                     (isPlatformAdmin() ||
                      (isBusinessAdmin() && resource.data.businessId == getBusinessId()));

      allow create: if isAuthenticated() && isBusinessAdmin() && isWritingOwnBusinessId();

      allow update: if isAuthenticated() && (
                       // Business Admin de plataforma o tenant para gestionar la invitación
                       (isWritingOwnBusinessId() && (isPlatformAdmin() || isBusinessAdmin())) ||
                       // Usuario que acepta la invitación: debe estar PENDING, acceptedByUid debe ser el currentUid(), el estado pasa a ACCEPTED
                       // Y los campos inmutables (email, businessId, branchId, orgId, targetRole, token, expiresAt) NO PUEDEN MODIFICARSE
                       (resource.data.status == "PENDING" &&
                        request.resource.data.get("acceptedByUid", "") == currentUid() &&
                        request.resource.data.get("status", "") == "ACCEPTED" &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["email", "businessId", "branchId", "orgId", "targetRole", "token", "expiresAt"]))
                     );

      allow delete: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
    }

    // ─── /sessions/{sessionId} ───────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() &&
                     (currentUid() == resource.data.uid || isPlatformAdmin());

      allow write: if isAuthenticated() && currentUid() == resource.data.uid;

      allow update: if isAuthenticated() && isPlatformAdmin();
    }

    // ─── /devices/{deviceId} ─────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow read: if isAuthenticated() &&
                     (resource == null || resource.data.uid == currentUid() || isPlatformAdmin());

      allow create, update: if isAuthenticated() &&
                               (request.resource.data.uid == currentUid() || isPlatformAdmin());

      allow delete: if isAuthenticated() &&
                       (resource.data.uid == currentUid() || isSuperAdmin());
    }

    // ─── /user_devices/{deviceDocId} ─────────────────────────────────────────
    match /user_devices/{deviceDocId} {
      allow read: if isAuthenticated() &&
                     (resource == null || resource.data.uid == currentUid() || isPlatformAdmin());

      allow create, update: if isAuthenticated() &&
                               (request.resource.data.uid == currentUid() || isPlatformAdmin());

      allow delete: if isAuthenticated() &&
                       (resource.data.uid == currentUid() || isPlatformAdmin());
    }

    // ─── /ubicaciones_repartidores/{motorizadoId} ─────────────────────────────
    match /ubicaciones_repartidores/{motorizadoId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               (currentUid() == motorizadoId || isPlatformAdmin());
    }

    // ─── /couriers/{courierId} ───────────────────────────────────────────────
    match /couriers/{courierId} {
      allow read: if isAuthenticated();
      allow create: if isPlatformAdmin();
      allow update: if isAuthenticated() && (
                       isPlatformAdmin() ||
                       (currentUid() == courierId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["operationalMunicipalityId", "municipalityId", "departmentId", "tenantId", "commercialTenantId", "role", "userType", "status", "isApproved", "verified", "active", "isActive"])) ||
                       ((isBusinessAdmin() || isBusinessStaff()) && isTenantMember(resource.data.get("tenantId", null)))
                     );
      allow delete: if isPlatformAdmin();
    }

    // ─── /courier_shifts/{shiftId} ───────────────────────────────────────────
    match /courier_shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               (currentUid() == resource.data.get("courierId", currentUid()) ||
                                request.resource.data.get("courierId", "") == currentUid() ||
                                isPlatformAdmin());
    }

    function getCourierData() {
      return exists(/databases/$(database)/documents/couriers/$(currentUid()))
        ? get(/databases/$(database)/documents/couriers/$(currentUid())).data
        : (exists(/databases/$(database)/documents/users/$(currentUid()))
            ? get(/databases/$(database)/documents/users/$(currentUid())).data
            : {});
    }

    function getCourierMunicipality() {
      return getCourierData().get("operationalMunicipalityId",
               getCourierData().get("municipalityId",
                 getCourierData().get("cityId", "")));
    }

    function isCourierInSameTenantAndCity(resData) {
      return isPlatformAdmin() || (
        // Dominio B: X_TO_Y_DELIVERY no requiere coincidencia de tenant o municipio comercial
        resData.get("serviceType", "COMMERCE_DELIVERY") == "X_TO_Y_DELIVERY" ||
        // Dominio A: COMMERCE_DELIVERY exige estricto aislamiento de Tenant y de Municipio
        (
          // Tenant isolation
          (!isEiamV3() || resData.get("tenantId", "") == "" || resData.get("tenantId", null) == null || getTenantId() == null || getTenantId() == "" || getTenantId() == resData.get("tenantId", null) ||
           getCourierData().get("tenantId", "") == "" || getCourierData().get("tenantId", "") == resData.get("tenantId", "") || getCourierData().get("tenantId", "") == resData.get("commercialTenantId", "")) &&
          // Municipal isolation (fail-closed)
          getCourierMunicipality() != "" &&
          (resData.get("commercialMunicipalityId", "") == getCourierMunicipality() ||
           resData.get("businessMunicipalityId", "") == getCourierMunicipality() ||
           resData.get("originMunicipalityId", "") == getCourierMunicipality() ||
           resData.get("municipalityId", "") == getCourierMunicipality() ||
           resData.get("cityId", "") == getCourierMunicipality())
        )
      );
    }

        // ─── /orders/{orderId} ───────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
                     (currentUid() == resource.data.get("customerId", "") ||
                      currentUid() == resource.data.get("clienteId", "") ||
                      ownsBusiness(getOrderBusinessId(resource.data)) ||
                      isTenantMember(resource.data.get("tenantId", null)) ||
                      currentUid() == resource.data.get("assignedCourierId", "") ||
                      currentUid() == resource.data.get("motorizadoId", "") ||
                      (resource.data.get("rejectedByCouriers", []).hasAny([currentUid()])) ||
                      isPlatformAdmin() ||
                      resource.data.get("status", "") in ["ready", "READY", "listo", "LISTO", "assigned", "ASSIGNED", "in_transit", "en_ruta", "delivering", "DELIVERING", "preparing", "PREPARING", "courier_accepted", "COURIER_ACCEPTED", "aceptado_por_courier", "pending", "PENDING"]);

      allow create: if isAuthenticated() && (
                       // Dominio A: Pedido comercial de Cliente para sí mismo con estado inicial válido
                       (((request.resource.data.get("customerId", "") == currentUid() ||
                          request.resource.data.get("clienteId", "") == currentUid())) &&
                        request.resource.data.get("serviceType", "COMMERCE_DELIVERY") != "X_TO_Y_DELIVERY" &&
                        request.resource.data.get("status", "pending") in ["pending", "draft", "created"] &&
                        request.resource.data.get("paymentStatus", "pending") in ["pending", "PENDING", "created", "CREATED", "draft", "DRAFT"] &&
                        request.resource.data.get("paymentVerified", false) != true &&
                        // 🔒 C2D.35.GEO-R.2: Aislamiento intramunicipal estricto en creación de pedido
                        request.resource.data.get("commercialMunicipalityId", "") != "" &&
                        request.resource.data.get("destinationMunicipalityId", "") != "" &&
                        request.resource.data.get("commercialMunicipalityId", "") == request.resource.data.get("destinationMunicipalityId", "") &&
                        // 🔒 C2D.35.GEO-R.2: Integridad de comercio y sucursal
                        exists(/databases/$(database)/documents/businesses/$(request.resource.data.get("businessId", ""))) &&
                        (
                          request.resource.data.get("branchId", "") == "" ||
                          (
                            exists(/databases/$(database)/documents/branches/$(request.resource.data.branchId)) &&
                            get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.businessId == request.resource.data.businessId &&
                            get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.get("municipalityId", "") == request.resource.data.commercialMunicipalityId
                          )
                        ) &&
                        (!request.resource.data.keys().hasAny(["platform"]) || request.resource.data.get("platform", "") in ["ANDROID", "IOS", "WEB"]) &&
                        !request.resource.data.keys().hasAny(["assignedCourierId", "motorizadoId", "deliveredAt", "completedAt", "providerTransactionId", "authCode", "gatewayResponse", "settlementId", "authoritativeGatewayVerified"])) ||
                       // Dominio B: Encomienda X_TO_Y_DELIVERY de Cliente para sí mismo (status ready para efectivo o payment_verifying)
                       (((request.resource.data.get("customerId", "") == currentUid() ||
                          request.resource.data.get("clienteId", "") == currentUid())) &&
                        request.resource.data.get("serviceType", "") == "X_TO_Y_DELIVERY" &&
                        request.resource.data.get("status", "ready") in ["ready", "READY", "payment_verifying", "PAYMENT_VERIFYING", "pending", "PENDING", "draft", "created"] &&
                        request.resource.data.get("paymentStatus", "pending") in ["pending", "PENDING", "created", "CREATED", "draft", "DRAFT", "payment_verifying", "PAYMENT_VERIFYING"] &&
                        request.resource.data.get("paymentVerified", false) != true &&
                        (!request.resource.data.keys().hasAny(["platform"]) || request.resource.data.get("platform", "") in ["ANDROID", "IOS", "WEB"]) &&
                        !request.resource.data.keys().hasAny(["assignedCourierId", "motorizadoId", "deliveredAt", "completedAt", "providerTransactionId", "authCode", "gatewayResponse", "settlementId", "authoritativeGatewayVerified"])) ||
                       // Personal de comercio creando pedido manual para su propio negocio / tenant
                       ((isWritingOwnBusinessId() || isTenantMember(request.resource.data.get("tenantId", null))) && (isBusinessAdmin() || isBusinessStaff())) ||
                       // Platform Admin
                       isPlatformAdmin()
                     );

      allow update: if isAuthenticated() && (
                        isPlatformAdmin() ||
                        // Cliente: Cancelación de su propio pedido si el estado actual es cancelable o reseteo de unreadCustomerCount
                        (((currentUid() == resource.data.get("customerId", "") ||
                           currentUid() == resource.data.get("clienteId", ""))) &&
                         ((resource.data.get("status", "pending") in ["pending", "draft", "created", "preparing", "PENDIENTE", "PREPARANDO"] &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["status", "estado", "cancelReason", "cancelledAt", "historialEstados", "updatedAt"])) ||
                          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unreadCustomerCount"])))) ||
                        // Merchant Admin (OWNER/MANAGER): Puede modificar campos operativos pero NO campos de identidad ni origen de plataforma
                        ((ownsBusiness(getOrderBusinessId(resource.data)) || isTenantMember(resource.data.get("tenantId", null))) && isBusinessAdmin() &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["customerId", "clienteId", "businessId", "tenantId", "createdAt", "platform"])) ||
                        // Personal de comercio (CASHIER, COOK, SUPERVISOR)
                       ((ownsBusiness(getOrderBusinessId(resource.data)) || isTenantMember(resource.data.get("tenantId", null))) && isBusinessStaff() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["status", "estado", "historialEstados", "notasCocina", "preparadoAt", "updatedAt", "rejectionReason", "rejectedAt", "rejectedByCouriers", "rejectionHistory", "rejectedBy", "assignedCourierId", "motorizadoId", "driverName", "assignedCourierName", "motorizadoNombre", "assignedCourierPlate", "motorizadoPlaca", "assignedAt"])) ||
                        // Repartidor/Motorizado: Separación de Reclamo Inicial vs Operación en Curso (BSD-C4-002)
                        (
                          (
                            isPlatformAdmin() ||
                            // Caso A: Operación sobre pedido ya asignado (ÚNICAMENTE el motorizado asignado)
                            (currentUid() == resource.data.get("assignedCourierId", "") || currentUid() == resource.data.get("motorizadoId", "")) ||
                            // Caso B: Reclamo o rechazo de pedido disponible sin asignar o asignado a sí mismo
                            (
                              (resource.data.get("assignedCourierId", "") == "" || resource.data.get("assignedCourierId", null) == null || currentUid() == resource.data.get("assignedCourierId", "")) &&
                              (resource.data.get("motorizadoId", "") == "" || resource.data.get("motorizadoId", null) == null || currentUid() == resource.data.get("motorizadoId", "")) &&
                              (request.resource.data.get("assignedCourierId", "") == currentUid() || request.resource.data.get("motorizadoId", "") == currentUid() || request.resource.data.get("rejectedByCouriers", []).hasAny([currentUid()])) &&
                              (resource.data.get("status", "") in ["ready", "READY", "listo", "LISTO", "assigned", "ASSIGNED", "asignado", "ASIGNADO", "preparing", "PREPARING", "pending", "PENDING", "courier_accepted", "COURIER_ACCEPTED", "aceptado_por_courier"] ||
                               resource.data.get("serviceType", "") == "X_TO_Y_DELIVERY")
                            )
                          ) &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(["status", "estado", "historialEstados", "ubicacionRepartidor", "deliveredAt", "entregadoAt", "acceptedAt", "pickedUpAt", "completedAt", "completadoAt", "updatedAt", "courierPhase", "assignedCourierId", "motorizadoId", "driverName", "motorizadoNombre", "driverPhone", "motorizadoTelefono", "cashReceived", "changeGiven", "cashCollectedNet", "cashDiscrepancy", "discrepancyAmount", "financialReconciliationStatus", "reconciledAt", "rejectionReason", "rejectedAt", "rejectionHistory", "rejectedByCouriers", "unreadCourierCount"])
                        )
                      );

      allow delete: if isSuperAdmin();

      // ─── /orders/{orderId}/messages/{messageId} (Live Chat & Historial Contextual) ───
      match /messages/{messageId} {
        // Lectura: Participantes autorizados del pedido (Cliente, Courier asignado), Comercio, Tenant y Admin
        allow read: if isAuthenticated() && (
          isPlatformAdmin() ||
          currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("customerId", "") ||
          currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("clienteId", "") ||
          currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("assignedCourierId", "") ||
          currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("motorizadoId", "") ||
          ownsBusiness(getOrderBusinessId(get(/databases/$(database)/documents/orders/$(orderId)).data)) ||
          isTenantMember(get(/databases/$(database)/documents/orders/$(orderId)).data.get("tenantId", null))
        );

        // Creación: Append-only por Cliente o Motorizado asignado activo en pedidos no finalizados
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == currentUid() &&
          request.resource.data.orderId == orderId &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          (
            (request.resource.data.senderRole == "CUSTOMER" &&
             (currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("customerId", "") ||
              currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("clienteId", ""))) ||
            (request.resource.data.senderRole == "COURIER" &&
             (currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("assignedCourierId", "") ||
              currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("motorizadoId", "")))
          ) &&
          !(get(/databases/$(database)/documents/orders/$(orderId)).data.get("status", "") in ["delivered", "completed", "cancelled", "entregado", "completado", "cancelado"]);

        // Actualización: Restringida exclusivamente a recibos de lectura (readAt, readBy, status)
        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt", "readBy", "status"]) &&
          (
            currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("customerId", "") ||
            currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("clienteId", "") ||
            currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("assignedCourierId", "") ||
            currentUid() == get(/databases/$(database)/documents/orders/$(orderId)).data.get("motorizadoId", "") ||
            isPlatformAdmin()
          );

        // Prohibición absoluta de borrado (Auditoría permanente inmutable)
        allow delete: if false;
      }
    }

    // ─── /deliveryTrips/{tripId} (Dominio B: Envíos X a Y) ───────────────────
    match /deliveryTrips/{tripId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
                       (((request.resource.data.get("customerId", "") == currentUid() ||
                          request.resource.data.get("clienteId", "") == currentUid())) &&
                        request.resource.data.get("status", "PENDING") in ["PENDING", "pending", "PAYMENT_VERIFYING", "payment_verifying", "draft", "created"] &&
                        request.resource.data.get("paymentStatus", "pending") in ["pending", "PENDING", "created", "CREATED", "draft", "DRAFT", "payment_verifying", "PAYMENT_VERIFYING"] &&
                        request.resource.data.get("paymentVerified", false) != true &&
                        !request.resource.data.keys().hasAny(["assignedCourierId", "motorizadoId", "deliveredAt", "completedAt", "providerTransactionId", "authCode", "gatewayResponse", "settlementId", "authoritativeGatewayVerified"])) ||
                       isPlatformAdmin()
                     );

      allow update: if isAuthenticated() && (
                       // Platform Admin: Modificación completa
                       isPlatformAdmin() ||
                       // Cliente: Cancelación o actualización de oferta/notas
                       (((currentUid() == resource.data.get("customerId", "") ||
                          currentUid() == resource.data.get("clienteId", ""))) &&
                        resource.data.get("status", "PENDING") in ["PENDING", "pending", "PAYMENT_VERIFYING", "payment_verifying", "draft", "created"] &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["status", "estado", "cancelReason", "cancelledAt", "customerOffer", "notes", "updatedAt"])) ||
                       // Repartidor/Motorizado: Aceptación, entrega y tracking de ubicación
                       ((currentUid() == resource.data.get("assignedCourierId", "") ||
                         currentUid() == resource.data.get("motorizadoId", "") ||
                         resource.data.get("assignedCourierId", "") == "" ||
                         resource.data.get("motorizadoId", "") == "") &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["status", "estado", "historialEstados", "ubicacionRepartidor", "deliveredAt", "entregadoAt", "acceptedAt", "pickedUpAt", "completedAt", "completadoAt", "updatedAt", "courierPhase", "assignedCourierId", "motorizadoId", "driverName", "motorizadoNombre", "driverPhone", "motorizadoTelefono", "cashReceived", "cashDiscrepancy", "rejectionReason", "rejectedAt", "rejectionHistory", "rejectedByCouriers"]))
                     );

      allow delete: if isSuperAdmin();
      // ─── /deliveryTrips/{tripId}/messages/{messageId} (Live Chat Encomiendas X→Y) ───
      match /messages/{messageId} {
        // Lectura: Participantes autorizados del viaje (Cliente remitente, Courier asignado) y Admin
        allow read: if isAuthenticated() && (
          isPlatformAdmin() ||
          currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("customerId", "") ||
          currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("clienteId", "") ||
          currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("assignedCourierId", "") ||
          currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("courierId", "") ||
          currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("motorizadoId", "")
        );

        // Creación: Append-only por Cliente o Motorizado asignado en viajes no finalizados
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == currentUid() &&
          (request.resource.data.orderId == tripId || request.resource.data.tripId == tripId) &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          (
            (request.resource.data.senderRole == "CUSTOMER" &&
             (currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("customerId", "") ||
              currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("clienteId", ""))) ||
            (request.resource.data.senderRole == "COURIER" &&
             (currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("assignedCourierId", "") ||
              currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("courierId", "") ||
              currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("motorizadoId", "")))
          ) &&
          !(get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("status", "") in ["DELIVERED", "COMPLETED", "CANCELLED", "delivered", "completed", "cancelled", "entregado", "completado", "cancelado"]);

        // Actualización: Restringida a recibos de lectura
        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt", "readBy", "status"]) &&
          (
            currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("customerId", "") ||
            currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("clienteId", "") ||
            currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("assignedCourierId", "") ||
            currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("courierId", "") ||
            currentUid() == get(/databases/$(database)/documents/deliveryTrips/$(tripId)).data.get("motorizadoId", "") ||
            isPlatformAdmin()
          );

        // Prohibición absoluta de borrado (Auditoría permanente inmutable)
        allow delete: if false;
      }
    }

    // ─── /products/{productId} ───────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true; // Public by design for Marketplace e-Commerce catalog access

      allow create: if isAuthenticated() &&
                       isWritingOwnBusinessId() &&
                       (isPlatformAdmin() || isBusinessAdmin());

      allow update: if isAuthenticated() &&
                       isWritingOwnBusinessId() &&
                       (isPlatformAdmin() || isBusinessAdmin() ||
                        (isBusinessStaff() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(["isAvailable", "available", "active", "stockStatus", "stock", "updatedAt"])));

      allow delete: if isAuthenticated() &&
                       (ownsBusiness(resource.data.businessId) && isBusinessAdmin() || isPlatformAdmin());
    }

    // ─── /audit_events/{eventId} ─────────────────────────────────────────────
    match /audit_events/{eventId} {
      allow read: if isAuthenticated() &&
                     (currentUid() == resource.data.get("uid", "") ||
                      currentUid() == resource.data.get("actorUid", "") ||
                      ownsBusiness(resource.data.businessId) ||
                      isPlatformAdmin());

      allow create: if isAuthenticated() && (
                       isPlatformAdmin() ||
                       request.resource.data.get("uid", "") == currentUid() ||
                       request.resource.data.get("actorUid", "") == currentUid() ||
                       ownsBusiness(request.resource.data.get("businessId", null))
                     );

      allow update, delete: if isPlatformAdmin();
    }

    // ─── /roles/{roleId} (EIAM v2.2) ──────────────────────────────────────────
    match /roles/{roleId} {
      allow read: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
      allow write: if isPlatformAdmin();
    }

    // ─── /permissions/{docId} (EIAM v2.2) ────────────────────────────────────
    match /permissions/{docId} {
      allow read: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
      allow write: if isPlatformAdmin();
    }

    // ─── /merchant_applications/{appId} (ADR-011 & Tenant Isolation Enterprise) ─
    match /merchant_applications/{appId} {
      // Las creaciones públicas se procesan exclusivamente vía Cloud Function (Admin SDK)
      // para garantizar validación de negocio, tenant resolution e idempotencia.
      allow create: if isPlatformAdmin();

      // Lectura: Platform Admin, Admin del mismo Tenant, o el solicitante autenticado por email
      allow read: if isPlatformAdmin() ||
                     isTenantMember(resource.data.get("tenantId", null)) ||
                     (isAuthenticated() && request.auth.token.email == resource.data.email);

      // Modificación de estado: Platform Admin o Business Admin del mismo Tenant.
      // Prohibición absoluta de mutar tenantId, appId, email o createdAt (Inmutabilidad Estricta).
      allow update: if isPlatformAdmin() ||
                       (isBusinessAdmin() &&
                        isTenantMember(resource.data.get("tenantId", null)) &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["appId", "applicationId", "tenantId", "createdAt", "email", "ruc"]));

      // Ninguna solicitud se elimina (auditabilidad permanente)
      allow delete: if false;
    }

    // ─── /courier_applications/{appId} (Courier Onboarding & Tenant Isolation) ─
    match /courier_applications/{appId} {
      // Creaciones públicas procesadas exclusivamente vía Cloud Function submitCourierApplication (Admin SDK)
      allow create: if isPlatformAdmin();

      // Lectura: Platform Admin, Admin del mismo Tenant, o el aspirante autenticado por email
      allow read: if isPlatformAdmin() ||
                     isTenantMember(resource.data.get("tenantId", null)) ||
                     (isAuthenticated() && (
                       request.auth.token.email == resource.data.personal.email ||
                       request.auth.token.email == resource.data.email
                     ));

      // Modificación de estado: Platform Admin o Business Admin del mismo Tenant.
      // Prohibición absoluta de mutar tenantId, applicationId, nationalId o createdAt.
      allow update: if isPlatformAdmin() ||
                       (isBusinessAdmin() &&
                        isTenantMember(resource.data.get("tenantId", null)) &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["applicationId", "tenantId", "createdAt", "personal.nationalId"]));

      // Inmutabilidad histórica: ninguna solicitud se elimina físicamente
      allow delete: if false;
    }

    // ─── /courier_profile_requests/{requestId} (Edición de Perfil de Motorizado) ─
    match /courier_profile_requests/{requestId} {
      // Lectura: Únicamente el propio repartidor autenticado o administradores de plataforma
      allow read: if isAuthenticated() && (
        isPlatformAdmin() ||
        (resource != null && resource.data.courierId == currentUid())
      );

      // Creación: El propio repartidor autenticado para su propio courierId con estado inicial PENDING_REVIEW
      allow create: if isAuthenticated() && (
        isPlatformAdmin() ||
        (
          request.resource.data.courierId == currentUid() &&
          request.resource.data.get("status", "PENDING_REVIEW") in ["PENDING_REVIEW", "pending_review"] &&
          !request.resource.data.keys().hasAny(["approvedBy", "approvedAt", "reviewedBy", "reviewedAt", "rejectionReason"])
        )
      );

      // Modificación:
      // - Platform Admin: Aprobación / Rechazo con decisión de gobernanza
      // - Motorizado: Cancelación de su propia solicitud únicamente si continúa en PENDING_REVIEW
      allow update: if isAuthenticated() && (
        isPlatformAdmin() ||
        (
          resource.data.courierId == currentUid() &&
          resource.data.get("status", "PENDING_REVIEW") == "PENDING_REVIEW" &&
          request.resource.data.get("status", "") == "CANCELLED" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "cancelledAt"])
        )
      );

      // Inmutabilidad histórica: ninguna solicitud se elimina físicamente
      allow delete: if false;
    }

    // ─── /restaurant_settings/{restaurantId} (SSOT-01 Compliance) ────────────
    match /restaurant_settings/{restaurantId} {
      allow read: if isAuthenticated() &&
                     (isPlatformAdmin() || ownsBusiness(restaurantId));

      allow write: if isAuthenticated() &&
                      (ownsBusiness(restaurantId) || isPlatformAdmin());
    }

    // ─── /dashboard_summary/{merchantId} (ADR-003 Aggregated Dashboard) ──────
    match /dashboard_summary/{merchantId} {
      allow read: if isAuthenticated() &&
                     (isPlatformAdmin() || ownsBusiness(merchantId));

      allow create, update, delete: if isPlatformAdmin();
    }

    // ─── /financial_events/{eventId} (Phase 5 Finance Integration) ──────────
    // Inmutables: solo el Admin SDK (Cloud Functions) puede escribirlos.
    // Ningún cliente puede crear, modificar o eliminar eventos financieros.
    match /financial_events/{eventId} {
      allow read: if isAuthenticated() &&
                     (ownsBusiness(resource.data.businessId) ||
                      isTenantMember(resource.data.get("tenantId", resource.data.get("orgId", null))) ||
                      isPlatformAdmin());

      // Solo escritura desde Admin SDK (Cloud Functions bypassa reglas).
      // Prevenimos escrituras directas desde cualquier cliente:
      allow create, update, delete: if isPlatformAdmin();
    }

    // ─── /merchant_summaries/{businessId} (Phase 5 Finance Integration) ─────
    // Documento de solo lectura para el comercio. Solo actualizable via Admin SDK.
    match /merchant_summaries/{businessId} {
      allow read: if isAuthenticated() &&
                     (ownsBusiness(businessId) ||
                      isTenantMember(resource.data.get("tenantId", resource.data.get("orgId", null))) ||
                      isPlatformAdmin());

      // Escritura solo desde Admin SDK (Cloud Functions con FieldValue.increment):
      allow create, update: if isPlatformAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── /merchant_settlements/{settlementId} (BSD-FINANCE-MERCHANT-SETTLEMENT-001) ───
    // Liquidaciones financieras inmutables por comercio.
    // Lectura: Platform Admin o el comercio propietario (tenant isolation estricto).
    // Escritura: Totalmente prohibida a clientes; exclusivamente via Admin SDK (Cloud Functions).
    match /merchant_settlements/{settlementId} {
      allow read: if isAuthenticated() &&
                     (ownsBusiness(resource.data.businessId) ||
                      isTenantMember(resource.data.get("tenantId", resource.data.get("orgId", null))) ||
                      isPlatformAdmin());
      allow write: if false; // Inmutabilidad y máquina de estados controlada 100% en backend
    }

    // ─── /merchant_settlement_configs/{businessId} (Configuración de Periodicidad) ───
    match /merchant_settlement_configs/{businessId} {
      allow read: if isAuthenticated() &&
                     (ownsBusiness(businessId) ||
                      isTenantMember(resource.data.get("tenantId", resource.data.get("orgId", null))) ||
                      isPlatformAdmin());
      // Admin configura periodicidad; comercio puede actualizar datos bancarios
      allow create, update: if isAuthenticated() && (
        isPlatformAdmin() ||
        (ownsBusiness(businessId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankDetails', 'updatedAt', 'updatedByUid']))
      );
      allow delete: if isSuperAdmin();
    }

    // ─── /system_config/{docId} (SSOT Global Application Configuration) ───────
    match /system_config/{docId} {
      allow read: if true; // Lectura pública para que Android e iOS verifiquen modo mantenimiento, soporte y versión mínima
      allow write: if isPlatformAdmin();
    }

    // ─── /support_tickets/{ticketId} (Sistema de Soporte & Ayuda Enterprise) ─
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == currentUid() ||
        resource.data.userId == currentUid() ||
        isPlatformAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == currentUid() ||
        request.resource.data.userId == currentUid() ||
        isPlatformAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.customerId == currentUid() ||
        resource.data.userId == currentUid() ||
        isPlatformAdmin()
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.customerId == currentUid() ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == currentUid() ||
          isPlatformAdmin()
        );
        allow create: if isAuthenticated() && (
          (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.customerId == currentUid() && request.resource.data.senderId == currentUid()) ||
          (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == currentUid() && request.resource.data.senderId == currentUid()) ||
          isPlatformAdmin()
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.customerId == currentUid() ||
          isPlatformAdmin()
        );
        allow delete: if isSuperAdmin();
      }
    }

    // ─── /dynamic_menu/{itemId} (Actividad #10: Menú Dinámico Administrable) ─
    match /dynamic_menu/{itemId} {
      allow read: if true; // Lectura pública para la Customer App
      allow write: if isAuthenticated() && (
        isPlatformAdmin() || 
        (isBusinessAdmin() && isTenantMember(request.resource.data.get("tenantId", null)))
      );
    }

    // ─── /promotional_popups/{popupId} (Actividad #10: Pop-Up Promocional) ───
    match /promotional_popups/{popupId} {
      allow read: if true; // Lectura pública para renderizado de campañas emergentes
      allow write: if isAuthenticated() && (
        isPlatformAdmin() || 
        (isBusinessAdmin() && isTenantMember(request.resource.data.get("tenantId", null)))
      );
    }

    // ─── /platform_config/{docId} (configuración global de plataforma) ───────
    match /platform_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── /promotions/{promoId} (Marketplace Promotions SSOT) ───────────────
    match /promotions/{promoId} {
      // Lectura pública — necesaria para que Customer App consulte promociones activas en tiempo real
      allow read: if true;
      
      // Creación: Platform Admin para cualquier negocio o global; Business Admin solo para su propio comercio
      allow create: if isAuthenticated() && (
        isPlatformAdmin() || 
        (isBusinessAdmin() && isWritingOwnBusinessId())
      );

      // Actualización / Eliminación: Platform Admin o Business Admin propietario
      allow update: if isAuthenticated() && (
        isPlatformAdmin() || 
        (isBusinessAdmin() && ownsBusiness(resource.data.get("businessId", null)))
      );

      allow delete: if isAuthenticated() && (
        isPlatformAdmin() || 
        (isBusinessAdmin() && ownsBusiness(resource.data.get("businessId", null)))
      );
    }

    match /dashboard/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ─── /system_health (Active Sessions Heartbeat) ──────────────────────────
    match /system_health/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /dashboard_config/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /featuredProducts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
    }

    match /featured_products/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
    }

    match /flashDeals/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
    }

    match /flash_deals/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isPlatformAdmin() || isBusinessAdmin());
    }

    match /categories/{catId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isPlatformAdmin() || 
        (
          isBusinessAdmin() && 
          request.resource.data.businessId == getBusinessId() &&
          request.resource.data.get("type", "BUSINESS") in ["BUSINESS", "SUBCATEGORY"]
        )
      );
      allow update: if isAuthenticated() && (
        isPlatformAdmin() || 
        (
          isBusinessAdmin() && 
          request.resource.data.businessId == getBusinessId() &&
          request.resource.data.get("type", "BUSINESS") in ["BUSINESS", "SUBCATEGORY"] &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["type"]) || resource.data.get("type", "BUSINESS") in ["BUSINESS", "SUBCATEGORY"])
        )
      );
      allow delete: if isAuthenticated() && (
        isPlatformAdmin() || 
        (
          isBusinessAdmin() && 
          resource.data.businessId == getBusinessId() &&
          resource.data.get("type", "BUSINESS") in ["BUSINESS", "SUBCATEGORY"]
        )
      );
    }

    // ─── /business_categories/{categoryId} (Global Platform Master - SSOT) ──
    match /business_categories/{categoryId} {
      // Lectura pública autorizada para onboarding, comercios y clientes
      allow read: if true;

      // Creación restringida a Platform Admin con inicialización estricta
      allow create: if isAuthenticated() && isPlatformAdmin()
        && request.resource.data.id == categoryId
        && (request.resource.data.createdAt == request.time || isPlatformAdmin())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active is bool
        && request.resource.data.showInOnboarding is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.sortOrder is int;

      // Modificación restringida: blindaje total de campos inmutables
      allow update: if isAuthenticated() && isPlatformAdmin()
        // 1. Inmutabilidad estricta
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        // 2. Metadatos de actualización
        && (request.resource.data.updatedAt == request.time || isPlatformAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        // 3. Tipado de campos mutables gobernados
        && request.resource.data.active is bool
        && request.resource.data.showInOnboarding is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.sortOrder is int
        // 4. Invariante de negocio: si active es false, showInOnboarding DEBE ser false
        && (request.resource.data.active == true || request.resource.data.showInOnboarding == false);

      // Eliminación física terminantemente prohibida a todo nivel
      allow delete: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /users/{userId}/notifications/{notifId} {
      allow read, write: if true;
    }

    // ─── /incidents/{incidentId} ─────────────────────────────────────────────
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        isPlatformAdmin() || 
        isBusinessAdmin() || 
        isBusinessStaff() || 
        request.auth.token.get("userType", "") in ["courier", "motorizado", "driver"] ||
        getRole() in ["courier", "COURIER", "motorizado", "MOTORIZADO"]
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isPlatformAdmin();
    }

    // ─── /notification_campaigns/{campaignId} (Notification Center Enterprise) ──
    match /notification_campaigns/{campaignId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow create, update: if isAuthenticated() && isPlatformAdmin();
      allow delete: if isSuperAdmin();

      match /versions/{versionId} {
        allow read: if isAuthenticated() && isPlatformAdmin();
        allow create, update: if isAuthenticated() && isPlatformAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ─── /courier_cash_ledger/{entryId} (Subledger de Custodia / Solo Backend) ──
    match /courier_cash_ledger/{entryId} {
      allow read: if isAuthenticated() && (
        currentUid() == resource.data.courierId ||
        isPlatformAdmin() ||
        isBusinessAdmin() ||
        isSupervisor()
      );
      allow write: if false; // Solo Admin SDK (Cloud Functions)
    }

    // ─── /courier_balances/{courierId} (Balance Agregado / Solo Backend) ─────
    match /courier_balances/{courierId} {
      allow read: if isAuthenticated() && (
        currentUid() == courierId ||
        isPlatformAdmin() ||
        isBusinessAdmin() ||
        isSupervisor()
      );
      allow write: if false; // Solo Admin SDK (Cloud Functions)
    }

    // ─── /courier_settlements/{settlementId} (Liquidación y Arqueo) ──────────
    match /courier_settlements/{settlementId} {
      allow read: if isAuthenticated() && (
        currentUid() == resource.data.courierId ||
        isPlatformAdmin() ||
        isBusinessAdmin() ||
        isSupervisor()
      );
      allow write: if false; // Solo Admin SDK vía Callable HTTPS
    }

    // ─── /courier_daily_closures/{closureId} (Cierre Diario y Depósito Bancario) ──
    match /courier_daily_closures/{closureId} {
      allow read: if isAuthenticated() && (
        currentUid() == resource.data.courierId ||
        isPlatformAdmin() ||
        isBusinessAdmin() ||
        isSupervisor()
      );
      allow write: if false; // Solo Admin SDK vía Cloud Functions
    }

    // ─── /financial_events/{eventId} (General Accounting Ledger) ─────────────
    match /financial_events/{eventId} {
      allow read: if isAuthenticated() && (
        ownsBusiness(resource.data.businessId) ||
        isPlatformAdmin()
      );
      allow write: if false; // Solo Admin SDK (Cloud Functions)
    }

    // ─── /email_events/{eventId} (Actividad #20: Email Event Log Transaccional) ─
    match /email_events/{eventId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow write: if false; // Solo Admin SDK (Cloud Functions)
    }

    // ─── /email_templates/{templateId} (Actividad #20: Plantillas de Correo) ────
    match /email_templates/{templateId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow create, update: if isAuthenticated() && isPlatformAdmin();
      allow delete: if false; // Inmutabilidad histórica

      match /versions/{versionId} {
        allow read: if isAuthenticated() && isPlatformAdmin();
        allow write: if false; // Inmutable, solo Admin SDK
      }
    }

    // ─── /merchant_settlements/{settlementId} (BSD-FINANCE-MERCHANT-SETTLEMENT-001) ───
    match /merchant_settlements/{settlementId} {
      // Prohibida estrictamente cualquier escritura directa desde SDKs cliente (Zero Client Mutation)
      allow write: if false;

      // Lectura protegida: Platform Admin o Comercio titular del documento / Tenant
      allow read: if isAuthenticated() && (
        isPlatformAdmin() ||
        (getBusinessId() != null && getBusinessId() == resource.data.businessId) ||
        (getTenantId() != null && resource.data.get("tenantId", null) != null && getTenantId() == resource.data.tenantId)
      );
    }

    // ─── /merchant_settlement_configs/{businessId} (Configuración de Corte y Período) ───
    match /merchant_settlement_configs/{businessId} {
      allow write: if false; // Solo Admin SDK / Callable autoritativo
      allow read: if isAuthenticated() && (
        isPlatformAdmin() ||
        (getBusinessId() != null && getBusinessId() == businessId) ||
        (getTenantId() != null && resource.data.get("tenantId", null) != null && getTenantId() == resource.data.tenantId)
      );
    }

    // ─── /dashboard/{docId} (Customer Dashboard Dynamic Configuration) ───────
    match /dashboard/{docId} {
      allow read: if true; // Lectura pública para la sincronización reactiva del feed en Android
      allow write: if isPlatformAdmin();
    }

    // ─── /dashboard_events/{eventId} (Telemetry & Conversion Analytics) ──────
    match /dashboard_events/{eventId} {
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        (
          (getTenantId() != null && request.resource.data.tenantId == getTenantId()) ||
          (getTenantId() == null && request.resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "GLOBAL"))
        ) &&
        request.resource.data.keys().hasOnly([
          "eventId", "eventType", "itemType", "itemId", "itemName", 
          "customerId", "tenantId", "timestamp", "metadata"
        ]) &&
        request.resource.data.timestamp == request.time;

      allow update, delete: if false; // Inmutable append-only
      allow read: if isPlatformAdmin();
    }

    // ─── Denegar todo lo demás ────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
